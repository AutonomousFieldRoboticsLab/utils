<!-- ROS 1 launch file for scripts/extract_images.py. For ROS 2 use extract_images.launch.py -->
<launch>
  <arg name="image_dir" default="/path/to/images"/>
  <arg name="scale" default="0.5"/>
  <!-- Seconds between written images -->
  <arg name="write_every_secs" default="0.25"/>
  <arg name="compressed" default="true"/>
  <arg name="bag" default="/path/to/bag.bag"/>
  <arg name="stereo" default="false"/>

  <arg name="left" default="/left/image_raw"/>
  <arg name="right" default=""/>
  <!-- Bag time [s] range to extract, 0: no limit -->
  <arg name="start_time" default="0.0"/>
  <arg name="end_time" default="0.0"/>
  <arg name="display" default="false"/>

  <node name="gopro" pkg="utils_ros" type="extract_images.py" output="screen" required="true">
    <param name="image_dir" value="$(arg image_dir)"/>
    <param name="write_every_nsecs" value="$(arg write_every_secs)"/>
    <param name="bag" value="$(arg bag)"/>

    <param name="left" value="$(arg left)"/>
    <param name="right" value="$(arg right)"/>
    <param name="stereo" value="$(arg stereo)"/>
    <param name="compressed" value="$(arg compressed)"/>
    <param name="scale" value="$(arg scale)"/>
    <param name="start_time" value="$(arg start_time)"/>
    <param name="end_time" value="$(arg end_time)"/>
    <param name="display" value="$(arg display)"/>
  </node>
</launch>
