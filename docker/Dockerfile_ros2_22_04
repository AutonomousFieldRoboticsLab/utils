# utils_ros for ROS 2 Humble (Ubuntu 22.04).
#
# Build (from the repository root):
#   docker build -f docker/Dockerfile_ros2_22_04 -t utils_ros:humble .
#
# Run (mount the folder that holds your bags and trajectories at /utils_ws/data):
#   docker run --rm -it -v /path/to/data:/utils_ws/data utils_ros:humble \
#     ros2 launch utils_ros write_keyframe_images.launch.py \
#       bag_file:=/utils_ws/data/run traj_file:=/utils_ws/data/traj.txt \
#       image_dir:=/utils_ws/data/keyframes
FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /utils_ws

# Install dependencies from package.xml first, so this layer is cached across source changes
COPY package.xml src/utils_ros/package.xml
RUN . /opt/ros/$ROS_DISTRO/setup.sh \
    && apt-get update \
    && rosdep update --rosdistro $ROS_DISTRO \
    && rosdep install --from-paths src --ignore-src --rosdistro $ROS_DISTRO -y \
    && rm -rf /var/lib/apt/lists/*

# Build the package
COPY . src/utils_ros
RUN . /opt/ros/$ROS_DISTRO/setup.sh \
    && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

COPY docker/entrypoint.sh /entrypoint.sh
RUN echo "source /utils_ws/install/setup.bash" >> /root/.bashrc
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
